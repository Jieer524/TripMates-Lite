# TripMates-Lite repository ignore policy
#
# Commit source code, tests, documentation, required input data, assets, and
# curated research summaries. Ignore local environments, caches, QA products,
# and regenerable benchmark outputs.

# -----------------------------------------------------------------------------
# Python environments, caches, and test artefacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# -----------------------------------------------------------------------------
# Local application state and databases
# -----------------------------------------------------------------------------
data/itinerary_history.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# -----------------------------------------------------------------------------
# Node/package-manager installation artefacts
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Local research caches and archived API responses
# -----------------------------------------------------------------------------
cache/
archive/overpass_cache/*.json

# -----------------------------------------------------------------------------
# Generated paper, presentation, document-QA, and temporary work products
# -----------------------------------------------------------------------------
.ppt-build/
.workbuddy-ai/
ccfa-workfiles/
output/
tmp/
qa/
docx_render_check/
.docx-review/
.thesis_qa/
qa_docx_accessibility/
qa_docx_accessibility_red/

# Thesis-only helper scripts are local working files, not application source.
tools/

# The paper-review skill package is local review infrastructure. Keep it out
# of the application repository unless it is intentionally force-added.
.github/

# -----------------------------------------------------------------------------
# Regenerable research outputs
# -----------------------------------------------------------------------------
# Keep curated full-run summaries and manifests available for versioning, but
# do not add smoke-test folders or large raw measurement files by accident.
results/**/smoke/
results/**/raw_runs.csv
results/**/rq1_raw_runs.csv
!results/rq1_full_benchmark_minimum_deletion_primary/rq1_raw_runs.csv
!results/rq1_full_benchmark_corrected_static_rule/rq1_raw_runs.csv
!results/ablation_studies/candidate_window_sensitivity/raw_runs.csv
!results/ablation_studies/stability_ablation/raw_runs.csv
!results/ablation_studies/full_replanning_ablation/raw_runs.csv
results/**/latency_raw_measurements.csv
results/**/weather_ablation_raw_*.csv

# -----------------------------------------------------------------------------
# Operating-system and editor files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/

archive
